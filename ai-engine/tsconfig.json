{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "sourceMap": true
  },

  "include": [
    "**/*.ts",
    "**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}